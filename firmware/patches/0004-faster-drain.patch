diff --git a/omi/firmware/omi/src/lib/core/storage.c b/omi/firmware/omi/src/lib/core/storage.c
index e643de4c2e..d8558845ae 100644
--- a/omi/firmware/omi/src/lib/core/storage.c
+++ b/omi/firmware/omi/src/lib/core/storage.c
@@ -149,10 +149,102 @@ static uint8_t stop_started = 0;
 static uint8_t delete_started = 0;
 uint32_t remaining_length = 0;
 
+// --- 転送の改善（自前・上流 main の作りにならう）-----------------------------
+// 元の実装は「440バイト読む → 1個送る」の繰り返しで、読み出しの待ち時間のあいだに
+// 通信の機会（約30ms周期）が過ぎてしまい、1機会あたり2〜3個しか送れていなかった。
+//   ・まとめて読み、連続で送る
+//   ・送信完了を数え、在庫の2個は他の通知（電池残量など）のために残す
+//   ・送信に失敗したら、その分は送り直す（元は取りこぼしていた）
+#define STORAGE_BATCH_PACKETS 10
+#define STORAGE_TX_RESERVED 2 // CONFIG_BT_L2CAP_TX_BUF_COUNT=10 のうち他の通知用
+#define STORAGE_TX_INFLIGHT_MAX (10 - STORAGE_TX_RESERVED)
+
+K_SEM_DEFINE(storage_tx_sem, STORAGE_TX_INFLIGHT_MAX, STORAGE_TX_INFLIGHT_MAX);
+
+static void storage_tx_done(struct bt_conn *conn, void *user_data)
+{
+    ARG_UNUSED(conn);
+    ARG_UNUSED(user_data);
+    k_sem_give(&storage_tx_sem);
+}
+
+// 1個送る。在庫が空なら空くまで待つ（= 流量調整）。送れたら true
+static bool storage_send_one(struct bt_conn *conn, const uint8_t *data, uint16_t len)
+{
+    if (k_sem_take(&storage_tx_sem, K_MSEC(2000)) != 0) {
+        LOG_WRN("tx buffer wait timeout");
+        return false;
+    }
+
+    struct bt_gatt_notify_params params = {
+        .attr = &storage_service.attrs[1],
+        .data = data,
+        .len = len,
+        .func = storage_tx_done,
+    };
+
+    int err = bt_gatt_notify_cb(conn, &params);
+    if (err) {
+        k_sem_give(&storage_tx_sem);
+        return false;
+    }
+    return true;
+}
+
+// 送信中のものが全部片付くまで待つ（バッファを読み直しで上書きする前に必要）
+static void storage_wait_tx_drained(void)
+{
+    for (int i = 0; i < 400; i++) {
+        if (k_sem_count_get(&storage_tx_sem) == STORAGE_TX_INFLIGHT_MAX) {
+            return;
+        }
+        k_sleep(K_MSEC(5));
+    }
+    LOG_WRN("tx drain timeout");
+}
+
+// 転送の間だけ、通信の機会を増やしてもらう（30ms → 15ms）。
+// Apple の仕様で最短15ms・最大は最短+15ms以上・切断猶予2〜6秒。その範囲に収める。
+static void storage_request_fast_link(void)
+{
+    struct bt_conn *conn = get_current_connection();
+    if (!conn) {
+        return;
+    }
+
+    // 幅を持たせると相手が遅いほうを選ぶ（実測: 15〜30ms と頼んだら 30ms のままだった）。
+    // なので15msで固定して頼む。断られても転送は続く。
+    const struct bt_le_conn_param param = {
+        .interval_min = 12, // 15ms
+        .interval_max = 12, // 15ms
+        .latency = 0,
+        .timeout = 400, // 4秒
+    };
+
+    int err = bt_conn_le_param_update(conn, &param);
+    if (err) {
+        LOG_WRN("conn param update request failed: %d", err);
+    }
+
+    // 速いほうの電波（2Mbps）を明示的に要求する。
+    // 実測ではパケット1個に約3.8ms かかっており、1Mbps で動いている疑いがある。
+    const struct bt_conn_le_phy_param phy = {
+        .options = BT_CONN_LE_PHY_OPT_NONE,
+        .pref_tx_phy = BT_GAP_LE_PHY_2M,
+        .pref_rx_phy = BT_GAP_LE_PHY_2M,
+    };
+
+    err = bt_conn_le_phy_update(conn, &phy);
+    if (err) {
