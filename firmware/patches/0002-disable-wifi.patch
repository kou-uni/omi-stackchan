---
 omi/firmware/omi/omi.conf      | 80 +++++++++++++++++++---------------
 omi/firmware/omi/sysbuild.conf |  3 +-
 2 files changed, 47 insertions(+), 36 deletions(-)

diff --git a/omi/firmware/omi/omi.conf b/omi/firmware/omi/omi.conf
index e0c8415de1..4a42c7b62a 100644
--- a/omi/firmware/omi/omi.conf
+++ b/omi/firmware/omi/omi.conf
@@ -64,62 +64,62 @@ CONFIG_DISK_DRIVER_SDMMC=y
 # CONFIG_EXT2_DISK_STARTING_SECTOR=2082
 
 # wifi
-CONFIG_WIFI=y
-CONFIG_WIFI_NRF70=y
-CONFIG_WIFI_FIXED_MAC_ADDRESS="14:5A:FC:5E:37:9C"
+# CONFIG_WIFI=y
+# CONFIG_WIFI_NRF70=y
+# CONFIG_WIFI_FIXED_MAC_ADDRESS="14:5A:FC:5E:37:9C"
 # WPA supplicant
-CONFIG_WIFI_NM_WPA_SUPPLICANT=y
-CONFIG_WIFI_READY_LIB=y
+# CONFIG_WIFI_NM_WPA_SUPPLICANT=y
+# CONFIG_WIFI_READY_LIB=y
 
 # Soft AP
 CONFIG_NRF70_AP_MODE=y
-CONFIG_WIFI_NM_WPA_SUPPLICANT_AP=y
-CONFIG_WIFI_NM_WPA_SUPPLICANT_LOG_LEVEL_INF=y
+# CONFIG_WIFI_NM_WPA_SUPPLICANT_AP=y
+# CONFIG_WIFI_NM_WPA_SUPPLICANT_LOG_LEVEL_INF=y
 
 # Networking
-CONFIG_NETWORKING=y
-CONFIG_NET_SOCKETS=y
-CONFIG_NET_IPV4=y
-CONFIG_NET_IPV6=n
-CONFIG_NET_UDP=y
-CONFIG_NET_TCP=y
-CONFIG_NET_DHCPV4_SERVER=y
-
-CONFIG_NET_PKT_TX_COUNT=32
-CONFIG_NET_PKT_RX_COUNT=10
-CONFIG_NET_BUF_TX_COUNT=64
-CONFIG_NET_BUF_RX_COUNT=10
+# CONFIG_NETWORKING=y
+# CONFIG_NET_SOCKETS=y
+# CONFIG_NET_IPV4=y
+# CONFIG_NET_IPV6=n
+# CONFIG_NET_UDP=y
+# CONFIG_NET_TCP=y
+# CONFIG_NET_DHCPV4_SERVER=y
+
+# CONFIG_NET_PKT_TX_COUNT=32
+# CONFIG_NET_PKT_RX_COUNT=10
+# CONFIG_NET_BUF_TX_COUNT=64
+# CONFIG_NET_BUF_RX_COUNT=10
 
 CONFIG_HEAP_MEM_POOL_SIZE=175000
 CONFIG_HEAP_MEM_POOL_IGNORE_MIN=y
-CONFIG_NET_TC_TX_COUNT=1
+# CONFIG_NET_TC_TX_COUNT=1
 
-CONFIG_NET_IF_UNICAST_IPV4_ADDR_COUNT=1
-CONFIG_NET_MAX_CONTEXTS=8
-CONFIG_NET_MAX_CONN=8
-CONFIG_NET_CONTEXT_SYNC_RECV=y
+# CONFIG_NET_IF_UNICAST_IPV4_ADDR_COUNT=1
+# CONFIG_NET_MAX_CONTEXTS=8
+# CONFIG_NET_MAX_CONN=8
+# CONFIG_NET_CONTEXT_SYNC_RECV=y
 
 CONFIG_INIT_STACKS=y
 
-CONFIG_NET_L2_ETHERNET=y
+# CONFIG_NET_L2_ETHERNET=y
 
-CONFIG_NET_CONFIG_SETTINGS=y
-CONFIG_NET_CONFIG_INIT_TIMEOUT=0
-CONFIG_NET_PKT_BUF_TX_DATA_POOL_SIZE=12000
+# CONFIG_NET_CONFIG_SETTINGS=y
+# CONFIG_NET_CONFIG_INIT_TIMEOUT=0
+# CONFIG_NET_PKT_BUF_TX_DATA_POOL_SIZE=12000
 
 # Memories
 CONFIG_MAIN_STACK_SIZE=4096
-CONFIG_NET_TX_STACK_SIZE=2048
-CONFIG_NET_RX_STACK_SIZE=2048
+# CONFIG_NET_TX_STACK_SIZE=2048
+# CONFIG_NET_RX_STACK_SIZE=2048
 
 # Kernel options
 CONFIG_ENTROPY_GENERATOR=y
 CONFIG_POSIX_CLOCK=y
 
-CONFIG_NET_CONFIG_MY_IPV4_ADDR="192.168.1.1"
-CONFIG_NET_CONFIG_MY_IPV4_NETMASK="255.255.255.0"
-CONFIG_NET_CONFIG_MY_IPV4_GW="192.168.1.1"
-CONFIG_NET_MGMT_EVENT_QUEUE_TIMEOUT=5000
+# CONFIG_NET_CONFIG_MY_IPV4_ADDR="192.168.1.1"
+# CONFIG_NET_CONFIG_MY_IPV4_NETMASK="255.255.255.0"
+# CONFIG_NET_CONFIG_MY_IPV4_GW="192.168.1.1"
+# CONFIG_NET_MGMT_EVENT_QUEUE_TIMEOUT=5000
 
 #
 # Hardware settings
@@ -372,4 +372,14 @@ CONFIG_OMI_ENABLE_USB=n
 CONFIG_OMI_ENABLE_HAPTIC=y
 CONFIG_OMI_ENABLE_RFSW_CTRL=y
 CONFIG_OMI_ENABLE_MONITOR=n
-CONFIG_OMI_ENABLE_WIFI=y
+# CONFIG_OMI_ENABLE_WIFI=y
+
+
+# --- 自前: Wi-Fi 一式を無効化（2026-09-21）-------------------------------
+# 本体が自分で電波を出して通信する経路を丸ごと外す。
+#  ・使っていない（吸い出しは BLE 経由）
+#  ・外から触れる面を減らせる
+#  ・容量 -563KB / RAM -81KB（RAM 99.24% → 81.22%）
+# 戻すときは上のコメントアウトを外し、sysbuild.conf の SB_CONFIG_WIFI_NRF70 を y に。
+CONFIG_NETWORKING=n
+CONFIG_OMI_ENABLE_WIFI=n
diff --git a/omi/firmware/omi/sysbuild.conf b/omi/firmware/omi/sysbuild.conf
index be5a3f20e0..46dbcaef61 100644
--- a/omi/firmware/omi/sysbuild.conf
+++ b/omi/firmware/omi/sysbuild.conf
@@ -4,7 +4,8 @@
 # SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 #
 
-SB_CONFIG_WIFI_NRF70=y
+# SB_CONFIG_WIFI_NRF70=y   # 自前: Wi-Fi 無効化（2026-09-21）
+SB_CONFIG_WIFI_NRF70=n
 # SB_CONFIG_WIFI_NRF70_SCAN_ONLY=y
 
 SB_CONFIG_BOOTLOADER_MCUBOOT=y
